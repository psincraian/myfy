# Database Configuration
DATABASE_URL=postgresql+asyncpg://myfy:myfy_dev@localhost:5432/myfy_db
DATABASE_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Security
SECRET_KEY=change-this-in-production-use-long-random-string-at-least-32-chars
HTTPS_ONLY=false

# Application Configuration
LOG_LEVEL=INFO
ALLOWED_HOSTS=localhost,127.0.0.1
MYFY_FRONTEND_ENVIRONMENT=development

# External URLs
DOCS_URL=https://docs.myfy.dev
GITHUB_URL=https://github.com/psincraian/myfy
