# Database Configuration (DATABASE_* prefix)
DATABASE_URL=postgresql+asyncpg://myfy:myfy_dev@localhost:5432/myfy_db
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Security Configuration (SECURITY_* prefix)
SECURITY_SECRET_KEY=change-this-in-production-use-long-random-string-at-least-32-chars
SECURITY_HTTPS_ONLY=false
SECURITY_ALLOWED_HOSTS=localhost,127.0.0.1

# Application Configuration
LOG_LEVEL=INFO
MYFY_FRONTEND_ENVIRONMENT=development

# External URLs
DOCS_URL=https://docs.myfy.dev
GITHUB_URL=https://github.com/psincraian/myfy
