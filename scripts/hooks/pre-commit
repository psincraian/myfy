#!/bin/bash
#
# Pre-commit hook for myfy project
# Runs ruff format and ty check on staged Python files
#

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo -e "${BLUE}🔍 Running pre-commit checks...${NC}"

# Get list of staged Python files
STAGED_PY_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.py$' || true)

if [ -z "$STAGED_PY_FILES" ]; then
    echo -e "${GREEN}✓ No Python files staged for commit${NC}"
    exit 0
fi

echo -e "${BLUE}📝 Staged Python files:${NC}"
echo "$STAGED_PY_FILES" | sed 's/^/  /'
echo ""

# Function to check if uv is available
check_uv() {
    if ! command -v uv &> /dev/null; then
        echo -e "${RED}✗ Error: uv is not installed${NC}"
        echo -e "${YELLOW}Please install uv: https://docs.astral.sh/uv/${NC}"
        exit 1
    fi
}

# Check uv availability
check_uv

# Step 1: Run ruff format on staged files
echo -e "${BLUE}🎨 Running ruff format...${NC}"
if uv run ruff format $STAGED_PY_FILES; then
    echo -e "${GREEN}✓ Ruff format completed${NC}"

    # Re-stage formatted files
    for file in $STAGED_PY_FILES; do
        git add "$file"
    done
    echo -e "${GREEN}✓ Re-staged formatted files${NC}"
else
    echo -e "${RED}✗ Ruff format failed${NC}"
    exit 1
fi

echo ""

# Step 2: Run ruff check on packages and examples
echo -e "${BLUE}🔍 Running ruff check...${NC}"
if uv run ruff check packages/ examples/; then
    echo -e "${GREEN}✓ Ruff check passed${NC}"
else
    echo -e "${RED}✗ Ruff check failed${NC}"
    echo -e "${YELLOW}💡 Hint: Run 'uv run ruff check packages/ examples/ --fix' to auto-fix issues${NC}"
    exit 1
fi

echo ""

# Step 3: Run ty check on packages
echo -e "${BLUE}🔬 Running ty check...${NC}"
if uv run ty check packages/; then
    echo -e "${GREEN}✓ Type check passed${NC}"
else
    echo -e "${RED}✗ Type check failed${NC}"
    echo -e "${YELLOW}💡 Hint: Fix type errors reported above${NC}"
    exit 1
fi

echo ""
echo -e "${GREEN}✅ All pre-commit checks passed!${NC}"
echo ""

exit 0
